# Voorbeeld van de omgevingsvariabelen voor de API.
# Kopieer dit bestand naar `.env` en vul de waarden in die je hebt.
# Lees docs/DATA_SOURCES.md voor wat elke variabele doet.
#
# Wat al in je omgeving staat, wint van wat hier staat.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
API_PREFIX=/api
# Waar de webinterface vandaan mag komen. '*' staat alles toe; zet hier je
# eigen domein zodra je de app publiek draait.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Database en cache
# ---------------------------------------------------------------------------
# Een relatief pad wordt altijd gelezen vanaf de projectroot (de map met deze
# README), niet vanaf de map waaruit je het proces start. Zo is er nooit
# zomaar een tweede database. Een absoluut pad mag ook.
DATABASE_FILE=./data/boodschappen.db
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=2000

# ---------------------------------------------------------------------------
# Ophalen bij databronnen
# ---------------------------------------------------------------------------
# Zet op `false` om helemaal geen uitgaande verzoeken te doen. De app werkt
# dan volledig offline en laat alleen zien wat je zelf hebt ingevuld.
ALLOW_NETWORK=true
REQUEST_TIMEOUT_MS=15000
SYNC_MAX_RETRIES=2
SYNC_RETRY_DELAY_MS=500

# ---------------------------------------------------------------------------
# Databronnen
# ---------------------------------------------------------------------------
# Voor elke winkel die je wilt gebruiken heb je een officiële, geautoriseerde
# feed nodig. Vul de URL en het token in; laat je ze leeg, dan blijft de winkel
# "Niet gekoppeld" en worden er geen prijzen getoond.
#
# De vier winkels hieronder hebben geen openbare prijs-API. Hun websites
# verbieden geautomatiseerd ophalen, dus deze app bevat ook geen scraper.
#
# Snelst te starten: de gedeelde bron hieronder (PrijsProfeet) dekt Lidl,
# Albert Heijn en Dirk met één sleutel. Kruidvat zit er niet in.
#
# Per winkel zijn er vier variabelen, voor een eigen winkelkoppeling:
#   SOURCE_<WINKEL>_BASE_URL     basis-URL van de feed (verplicht om te koppelen)
#   SOURCE_<WINKEL>_API_KEY      token, gaat via een Authorization-header
#   SOURCE_<WINKEL>_HEADERS      extra headers, bv. "X-Tenant: mijnbedrijf"
#   SOURCE_<WINKEL>_TTL_SECONDS  eigen cachetijd voor deze winkel
#
# Een eigen SOURCE_<WINKEL>_BASE_URL heeft altijd voorrang boven PrijsProfeet.

# Gedeelde prijsbron: één officiële API-sleutel voor meerdere winkels.
# Vraag een (gratis) key aan via https://www.prijsprofeet.nl/api
# De sleutel gaat via de X-API-Key-header en komt nooit in de interface.
# Let op: op het gratis plan is bronvermelding verplicht, en reguliere
# schapprijjzen + prijsverloop zijn alleen in het Pro-plan.
# PRIJSPROFEET_API_KEY=
# PRIJSPROFEET_BASE_URL=https://www.prijsprofeet.nl/api/v1
# PRIJSPROFEET_USER_AGENT=BoodschappenApp/1.0 (https://jouw-domein.nl)

# SOURCE_LIDL_BASE_URL=https://jouw-feed.example/lidl
# SOURCE_LIDL_API_KEY=
# SOURCE_LIDL_TTL_SECONDS=900

# SOURCE_ALBERT_HEIJN_BASE_URL=https://jouw-feed.example/ah
# SOURCE_ALBERT_HEIJN_API_KEY=
# SOURCE_ALBERT_HEIJN_TTL_SECONDS=900

# SOURCE_DIRK_BASE_URL=https://jouw-feed.example/dirk
# SOURCE_DIRK_API_KEY=
# SOURCE_DIRK_TTL_SECONDS=900

# SOURCE_KRUIDVAT_BASE_URL=https://jouw-feed.example/kruidvat
# SOURCE_KRUIDVAT_API_KEY=
# SOURCE_KRUIDVAT_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Productmetadata (alleen barcode/naam, nooit prijzen)
# ---------------------------------------------------------------------------
# Standaard uit: hiermee zou een barcode naar een externe dienst gaan. Zet dit
# op `true` als je daar bewust akkoord mee bent. Er komen via deze bron nooit
# prijzen vandaan, alleen productnaam en barcode.
OPEN_FOOD_FACTS_ENABLED=false
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
# Vriendelijk en herkenbaar: sommige open bronnen verwachten een User-Agent
# waarin je kunt teruglezen wie je bent.
OPEN_FOOD_FACTS_USER_AGENT=BoodschappenApp/1.0 (https://example.nl/boodschappen-app)

# ---------------------------------------------------------------------------
# Lokale gebruiker
# ---------------------------------------------------------------------------
DEFAULT_USER_ID=default-user
DEFAULT_USER_NAME=Gebruiker
