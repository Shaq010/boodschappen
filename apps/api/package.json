{
  "name": "@boodschappen/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend: database, winkel-adapters, aanbiedingen, prijsoptimalisatie",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "node --watch --experimental-sqlite --import tsx/esm src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "node --experimental-sqlite --import tsx/esm src/db/migrate.ts",
    "db:reset": "node --experimental-sqlite --import tsx/esm src/db/migrate.ts --reset"
  },
  "dependencies": {
    "@boodschappen/core": "*",
    "@fastify/cors": "^10.0.1",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12"
  }
}
